<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Melon Codes" android:textSize="22sp" android:textStyle="bold" />

        <EditText android:id="@+id/nameInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Scraper name (e.g. MySite)" />

        <EditText android:id="@+id/baseUrlInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Website URL (https://site.com)"
            android:inputType="textUri" />

        <EditText android:id="@+id/searchPathInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Search path"
            android:text="/search?q={q}" android:inputType="textUri" />

        <Button android:id="@+id/generateBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Generate Watermelon link" />

        <TextView android:id="@+id/outputText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textIsSelectable="true" android:fontFamily="monospace" />

        <Button android:id="@+id/copyBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Copy link" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
